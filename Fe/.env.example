# Build-time Vite. Với frontend Docker/Nginx nên giữ cùng origin /api.
VITE_API_URL=/api

# Runtime Nginx. Thay URL/host mà không cần build lại image.
PORT=8080
NGINX_SERVER_NAME=_
NGINX_BACKEND_URL=https://task-management-software-q6r5.onrender.com
NGINX_BACKEND_HOST=task-management-software-q6r5.onrender.com
NGINX_CLIENT_MAX_BODY_SIZE=10m
