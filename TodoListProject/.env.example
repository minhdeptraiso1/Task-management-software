# Sao chép file này thành .env và thay các giá trị dùng cho môi trường của bạn.
# Không commit file .env hoặc secret thật lên Git.

# ============================================================
# Docker Compose / PostgreSQL
# ============================================================
DB_NAME=task_management
DB_USERNAME=task_user
DB_PASSWORD=change_me_database_password
POSTGRES_HOST_PORT=5432

# Dùng khi chạy backend trực tiếp ngoài Docker.
DB_URL=jdbc:postgresql://localhost:5432/task_management

# ============================================================
# Redis
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=3000ms

# ============================================================
# Backend / JWT
# ============================================================
SPRING_PROFILES_ACTIVE=docker
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=5173
CONTEXT_PATH=/api
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_ACCESS_EXP_MINUTES=30
JWT_REFRESH_EXP_DAYS=7

# Chỉ dùng khi chạy máy local qua docker-compose.tunnel.yaml.
# Lấy token tại Cloudflare Dashboard > Networking > Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=replace_with_cloudflare_tunnel_token

# ============================================================
# Upload / CORS
# ============================================================
FILE_STORAGE_ROOT_PATH=uploads
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=false

# ============================================================
# Backup / Restore
# ============================================================
# Tên container khớp với docker-compose.yaml hiện tại.
POSTGRES_CONTAINER=task_management_postgres
BACKEND_CONTAINER=task_management_backend
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=14
# docker: backup named volume /app/uploads qua backend container.
# local: backup trực tiếp thư mục UPLOAD_PATH trên máy chạy script.
UPLOAD_BACKUP_MODE=docker
UPLOAD_PATH=uploads
UPLOAD_CONTAINER_PATH=/app/uploads

# ============================================================
# Cache TTL tùy chọn
# ============================================================
CACHE_DEFAULT_TTL=PT10M
CACHE_TTL_USER_DETAIL=PT10M
CACHE_TTL_USER_CURRENT=PT5M
CACHE_TTL_USER_SEARCH=PT2M
CACHE_TTL_PROJECT_DETAIL=PT30M
CACHE_TTL_PROJECT_SEARCH_RESULT=PT2M
CACHE_TTL_PROJECT_MEMBERS=PT30M
CACHE_TTL_CURRENT_SPRINT=PT10M
CACHE_TTL_SPRINT_DETAIL=PT10M
CACHE_TTL_SPRINT_KANBAN=PT3M
CACHE_TTL_TASK_DETAIL=PT10M
CACHE_TTL_TASK_TIME_SUMMARY=PT5M
CACHE_TTL_SPRINT_TASK_STATISTICS=PT5M
CACHE_TTL_SPRINT_BURNDOWN=PT5M
CACHE_TTL_MY_DASHBOARD=PT5M
CACHE_TTL_PROJECT_DASHBOARD=PT5M
CACHE_TTL_NOTIFICATION_UNREAD_COUNT=PT1M
CACHE_TTL_NOTIFICATION_LIST=PT2M
