# Domain và email nhận cảnh báo chứng chỉ TLS từ Let's Encrypt.
DOMAIN=hoangitk.io.vn
WWW_DOMAIN=www.hoangitk.io.vn
APP_ORIGIN=https://hoangitk.io.vn
ACME_EMAIL=admin@hoangitk.io.vn

# Không sử dụng các giá trị ví dụ này trên máy chủ thật.
DB_NAME=task_management
DB_USERNAME=task_user
DB_PASSWORD=replace_with_a_strong_database_password
SERVER_PORT=8080
APP_VERSION=1.0.0
REDIS_TIMEOUT=3000ms
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_ACCESS_EXP_MINUTES=30
JWT_REFRESH_EXP_DAYS=7
HIBERNATE_JDBC_BATCH_SIZE=50
MULTIPART_MAX_FILE_SIZE=10MB
MULTIPART_MAX_REQUEST_SIZE=10MB
FILE_STORAGE_MAX_SIZE_BYTES=10485760
FILE_STORAGE_MAX_FILES_PER_ENTITY=20
FILE_STORAGE_MAX_PROJECT_STORAGE_BYTES=524288000
FILE_STORAGE_KEEP_DELETED_FILE_DAYS=30
CORS_ALLOW_CREDENTIALS=false
REPORT_PDF_FONT_PATH=fonts/NotoSans-Regular.ttf
REPORT_PDF_BOLD_FONT_PATH=fonts/NotoSans-Bold.ttf

# Gemini AI (inject through deployment secret)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TIMEOUT_SECONDS=30

# Cache TTL backend
CACHE_DEFAULT_TTL=PT10M
CACHE_TTL_USER_DETAIL=PT10M
CACHE_TTL_USER_CURRENT=PT5M
CACHE_TTL_USER_SEARCH=PT2M
CACHE_TTL_PROJECT_DETAIL=PT30M
CACHE_TTL_PROJECT_SEARCH_RESULT=PT2M
CACHE_TTL_PROJECT_MEMBERS=PT30M
CACHE_TTL_CURRENT_SPRINT=PT10M
CACHE_TTL_SPRINT_DETAIL=PT10M
CACHE_TTL_SPRINT_KANBAN=PT3M
CACHE_TTL_TASK_DETAIL=PT10M
CACHE_TTL_TASK_TIME_SUMMARY=PT5M
CACHE_TTL_SPRINT_TASK_STATISTICS=PT5M
CACHE_TTL_SPRINT_BURNDOWN=PT5M
CACHE_TTL_MY_DASHBOARD=PT5M
CACHE_TTL_PROJECT_DASHBOARD=PT5M
CACHE_TTL_NOTIFICATION_UNREAD_COUNT=PT1M
CACHE_TTL_NOTIFICATION_LIST=PT2M
CACHE_TTL_ATTACHMENT_LIST=PT5M
CACHE_TTL_ATTACHMENT_USAGE=PT5M
CACHE_TTL_ATTACHMENT_SECURITY_SUMMARY=PT30M
CACHE_TTL_FILE_CLEANUP_RESULT=PT1M
CACHE_TTL_ANALYTICS_VELOCITY=PT2M
CACHE_TTL_ANALYTICS_PROJECT_BURNUP=PT2M
CACHE_TTL_ANALYTICS_SPRINT_BURNUP=PT2M
CACHE_TTL_ANALYTICS_CUMULATIVE_FLOW=PT2M
CACHE_TTL_ANALYTICS_SUMMARY=PT2M
CACHE_TTL_ADMIN_DASHBOARD=PT2M
CACHE_TTL_ADMIN_AUDIT_SEARCH=PT1M
CACHE_TTL_ADMIN_AUDIT_DETAIL=PT5M
CACHE_TTL_ADMIN_AUDIT_SUMMARY=PT1M
CACHE_TTL_ADMIN_IMPORT_AUDIT_SEARCH=PT1M
CACHE_TTL_ADMIN_FILE_AUDIT_SEARCH=PT1M
CACHE_TTL_ADMIN_USER_ACTIVITY_AUDIT=PT1M

# Frontend và backend nằm chung Docker network.
NGINX_SERVER_NAME=_
NGINX_BACKEND_URL=http://backend:8080
NGINX_BACKEND_HOST=backend
NGINX_CLIENT_MAX_BODY_SIZE=10m
