# Domain và email nhận cảnh báo chứng chỉ TLS từ Let's Encrypt.
DOMAIN=hoangitk.io.vn
WWW_DOMAIN=www.hoangitk.io.vn
APP_ORIGIN=https://hoangitk.io.vn
ACME_EMAIL=admin@hoangitk.io.vn

# Không sử dụng các giá trị ví dụ này trên máy chủ thật.
DB_NAME=task_management
DB_USERNAME=task_user
DB_PASSWORD=replace_with_a_strong_database_password
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_ACCESS_EXP_MINUTES=30
JWT_REFRESH_EXP_DAYS=7
